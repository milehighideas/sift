#!/usr/bin/env bash
#
# sift pre-commit hook -- build, test, and lint before a commit ships.
#
#   * Swift changes (*.swift, Package.swift, Package.resolved)
#         -> swift build   (the whole package must compile)
#         -> swift test    (the full suite must pass; it runs in ~1s)
#   * Swift files staged  -> swift-format lint   (only if swift-format installed)
#   * Shell scripts (.sh/.command/.bash) and this hook -> shellcheck
#
# Build/test run against the working tree (what you'd get after the commit for a
# clean tree). Skip a single commit with `git commit --no-verify` if you must.
#
# Shared with the team via `core.hooksPath=.githooks`, which .envrc sets on
# directory entry (run `direnv allow` once to activate).

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

grn=$'\033[1;32m'; yel=$'\033[1;33m'; red=$'\033[1;31m'; rst=$'\033[0m'
ok()   { printf '%s[pre-commit]%s %s\n' "$grn" "$rst" "$*"; }
warn() { printf '%s[pre-commit]%s %s\n' "$yel" "$rst" "$*" >&2; }
fail() { printf '%s[pre-commit]%s %s\n' "$red" "$rst" "$*" >&2; }

# Partition staged (added/copied/modified) files by kind. NUL-delimited so
# paths with spaces survive intact.
swift_files=(); shell_files=(); pkg_touched=0
while IFS= read -r -d '' f; do
  case "$f" in
    *.swift)                     swift_files+=("$f") ;;
    *.sh | *.command | *.bash)   shell_files+=("$f") ;;
  esac
  case "$f" in
    *.swift | Package.resolved) pkg_touched=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)

# The hook itself is a shell script; lint it when it is being changed.
if git diff --cached --name-only --diff-filter=ACM -z | grep -qzx '.githooks/pre-commit'; then
  shell_files+=(".githooks/pre-commit")
fi

status=0

run() { # run <label> <cmd...> : show output only on failure
  local label="$1"; shift
  local out
  if out=$("$@" 2>&1); then
    ok "$label passed."
  else
    fail "$label failed:"
    printf '%s\n' "$out" >&2
    status=1
  fi
}

# --- Swift: build + test when the package changed --------------------------
if [ "$pkg_touched" -eq 1 ]; then
  if command -v swift >/dev/null 2>&1; then
    run "swift build" swift build
    run "swift test"  swift test
  else
    warn "swift not found -- skipping build/test."
  fi

  # Format lint (non-mutating), only if a formatter is installed.
  if [ ${#swift_files[@]} -gt 0 ]; then
    if command -v swift-format >/dev/null 2>&1; then
      run "swift-format lint" swift-format lint --strict "${swift_files[@]}"
    else
      warn "swift-format not found -- skipping format lint. Install: brew install swift-format"
    fi
  fi
fi

# --- Shell scripts: shellcheck ---------------------------------------------
if [ ${#shell_files[@]} -gt 0 ]; then
  if command -v shellcheck >/dev/null 2>&1; then
    run "shellcheck (${#shell_files[@]} file(s))" shellcheck --severity=warning "${shell_files[@]}"
  else
    warn "shellcheck not found -- skipping shell lint. Install: brew install shellcheck"
  fi
fi

if [ "$status" -ne 0 ]; then
  fail "commit blocked. Fix the issues above, or override with: git commit --no-verify"
  exit 1
fi

ok "all checks passed."
